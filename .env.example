OPENAI_API_KEY=sk-...

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=articles

EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

LLM_MODEL=gpt-5.4-mini
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.2

# Phase 5b.2: cross-encoder rerank via Voyage AI.
# Leave VOYAGE_API_KEY empty to disable rerank (system falls back to hybrid only).
VOYAGE_API_KEY=
RERANK_MODEL=rerank-2.5
RERANK_PREFETCH=30

# Faithfulness eval: Anthropic Claude as judge (cross-family to avoid same-model bias).
# Only used by scripts.eval_faithfulness — the main pipeline doesn't need this.
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-opus-4-7

DATA_DIR=./data
